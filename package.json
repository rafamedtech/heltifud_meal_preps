{
  "name": "nuxt-app",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "test": "pnpm test:unit && pnpm test:e2e",
    "test:ci": "pnpm lint && pnpm typecheck && pnpm test:unit && pnpm test:e2e",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "postinstall": "nuxt prepare && prisma generate",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "typecheck": "nuxt typecheck",
    "prepare": "husky",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "prisma db seed"
  },
  "dependencies": {
    "@googlemaps/js-api-loader": "^2.1.3",
    "@nuxt/eslint": "1.17.0",
    "@nuxt/image": "2.2.1",
    "@nuxt/ui": "4.12.0",
    "@nuxtjs/supabase": "2.1.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "date-fns": "^4.4.0",
    "eslint": "^10.15.0",
    "h3": "^1.15.11",
    "nuxt": "^4.6.4",
    "pg": "^8.23.1",
    "vue": "^3.5.45",
    "zod": "^4.6.7"
  },
  "packageManager": "pnpm@10.34.9",
  "devDependencies": {
    "@iconify-json/heroicons": "^1.2.3",
    "@iconify-json/lucide": "^1.2.155",
    "@iconify-json/mdi": "^1.2.3",
    "@netlify/nuxt": "1.0.1",
    "@nuxt/test-utils": "^4.4.0",
    "@playwright/test": "^1.65.1",
    "@types/google.maps": "^3.66.10",
    "@types/node": "^22.20.5",
    "@vue/test-utils": "^2.6.0",
    "happy-dom": "^21.0.4",
    "husky": "^9.1.7",
    "prisma": "^7.10.1",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "vitest": "^5.1.0",
    "vue-tsc": "3.3.14"
  },
  "pnpm": {
    "overrides": {
      "vue": "3.5.45",
      "@vue/compiler-sfc": "3.5.45",
      "@vue/runtime-core": "3.5.45",
      "@vue/runtime-dom": "3.5.45",
      "@vue/server-renderer": "3.5.45",
      "@vue/shared": "3.5.45"
    },
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma",
      "vue-demi"
    ]
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  }
}
