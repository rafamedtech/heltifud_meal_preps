NUXT_PUBLIC_SUPABASE_URL=
NUXT_PUBLIC_SUPABASE_KEY=
NUXT_PUBLIC_GOOGLE_MAPS_API_KEY=

DATABASE_URL=
DIRECT_URL=

# Integration scripts (scripts/verify-*.ts). The services import with Nuxt's `~~`
# alias; tsx resolves it from the server tsconfig generated by `nuxt prepare`.
TSX_TSCONFIG_PATH=.nuxt/tsconfig.server.json
# verify-database-hardening.ts: owner connection and the runtime role (see docs/runbook-base-de-datos.md)
ADMIN_DATABASE_URL=
APP_DATABASE_URL=

# Enable Netlify platform emulation in `nuxt dev` (requires access to api.netlify.com)
NETLIFY_DEV_EMULATION=false
