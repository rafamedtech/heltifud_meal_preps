generator client {
  provider = "prisma-client"
  output   = "../layers/menu/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MenuType {
  ESTANDAR
  VEGETARIANO
  PERSONALIZADO
}

model WeeklyMenu {
  id           String    @id @default(uuid())
  name         String
  menuType     MenuType  @default(ESTANDAR)
  isActive     Boolean   @default(false)
  startDate    DateTime
  endDate      DateTime
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  cycleId      String?   @map("cycle_id") @db.Uuid
  customerId   String?   @map("customer_id") @db.Uuid
  // 'ESTANDAR' | 'VEGETARIANO' for shared menus, the customer id for
  // personalised ones. Makes "one menu per scope per week" a plain unique key.
  cycleScope   String?   @map("cycle_scope")
  days         MenuDay[]
  sourceOrders Order[]
  cycle        WeeklyCycle? @relation(fields: [cycleId], references: [id], onDelete: Restrict)
  customer     Customer?    @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@unique([cycleId, cycleScope], map: "weekly_menu_cycle_scope_key")
  @@index([customerId], map: "weekly_menu_customer_idx")
  @@index([isActive])
  @@index([startDate])
  @@index([endDate])
}

model MenuDay {
  id           String     @id @default(uuid())
  weeklyMenuId String
  dayOfWeek    DayOfWeek
  order        Int
  weeklyMenu   WeeklyMenu @relation(fields: [weeklyMenuId], references: [id], onDelete: Cascade)
  slots        DaySlot[]

  @@unique([weeklyMenuId, dayOfWeek])
  @@unique([weeklyMenuId, order])
}

model DaySlot {
  id         String          @id @default(uuid())
  menuDayId  String
  slotType   SlotType
  contenedor String?
  menuDay    MenuDay         @relation(fields: [menuDayId], references: [id], onDelete: Cascade)
  components FoodComponent[]

  @@unique([menuDayId, slotType])
}

model FoodComponent {
  id            String           @id @default(uuid())
  daySlotId     String
  catalogItemId String?
  componentRole ComponentRole
  nombre        String
  descripcion   String
  calorias      Int
  imagen        String
  tipo          String
  daySlot       DaySlot          @relation(fields: [daySlotId], references: [id], onDelete: Cascade)
  catalogItem   FoodCatalogItem? @relation(fields: [catalogItemId], references: [id], onDelete: SetNull)

  @@index([catalogItemId])
  @@index([daySlotId, componentRole])
}

model FoodCatalogItem {
  id                String               @id @default(uuid())
  nombre            String
  descripcion       String
  preparacion       String               @default("")
  calorias          Int
  imagen            String
  tipo              String
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  components        FoodComponent[]
  orderComponents   OrderMenuComponent[]
  recipeIngredients RecipeIngredient[]

  @@index([nombre])
  @@index([tipo])
}

model Ingredient {
  id                String             @id @default(uuid())
  nombre            String
  nombreNormalizado String             @unique
  categoria         String
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  recipeIngredients RecipeIngredient[]

  @@index([categoria])
  @@index([nombre])
}

model RecipeIngredient {
  id                String          @id @default(uuid())
  foodCatalogItemId String
  ingredientId      String
  cantidad          Decimal         @db.Decimal(10, 3)
  unidad            String
  orden             Int
  foodCatalogItem   FoodCatalogItem @relation(fields: [foodCatalogItemId], references: [id], onDelete: Cascade)
  ingredient        Ingredient      @relation(fields: [ingredientId], references: [id], onDelete: Restrict)

  @@unique([foodCatalogItemId, ingredientId])
  @@unique([foodCatalogItemId, orden])
  @@index([ingredientId])
}

model Customer {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nombre            String
  telefono          String
  ubicacion1        String
  ubicacion2        String?
  correoElectronico String?  @map("correo_electronico")
  source            String   @default("whatsapp")
  status            String   @default("prospecto")
  tipoCliente       String   @default("menu") @map("tipo_cliente")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  firstDeliveryDay  DayOfWeek? @map("first_delivery_day")
  secondDeliveryDay DayOfWeek? @map("second_delivery_day")
  orders            Order[]
  personalMenus     WeeklyMenu[]

  @@index([status, tipoCliente, nombre, id], map: "customers_status_tipo_nombre_idx")
  @@index([source], map: "customers_source_idx")
  @@map("customers")
}

model Plan {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title       String
  description String
  image       String
  slotTypes   SlotType[]    @map("slot_types")
  isActive    Boolean       @default(true) @map("is_active")
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  variants    PlanVariant[]

  @@unique([title], map: "plans_title_key")
  @@index([isActive, title], map: "plans_active_title_idx")
  @@map("plans")
}

model PlanVariant {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  planId    String   @map("plan_id") @db.Uuid
  title     String
  daysCount Int      @map("days_count")
  price     Decimal  @db.Decimal(10, 2)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  plan      Plan     @relation(fields: [planId], references: [id], onDelete: Cascade)
  orders    Order[]

  @@unique([planId, daysCount], map: "plan_variants_plan_days_key")
  @@index([isActive, price], map: "plan_variants_active_price_idx")
  @@map("plan_variants")
}

model Order {
  id                       String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId               String          @map("customer_id") @db.Uuid
  planVariantId            String?         @map("plan_variant_id") @db.Uuid
  sourceWeeklyMenuId       String?         @map("source_weekly_menu_id")
  // Week of service the order belongs to.
  cycleId                  String          @map("cycle_id") @db.Uuid
  // Human-readable consecutive number.
  folio                    Int             @unique(map: "orders_folio_key") @default(autoincrement())
  status                   OrderStatus     @default(DRAFT)
  version                  Int             @default(1)
  // True when the order was captured once the customer cutoff had passed.
  capturedAfterCutoff      Boolean         @default(false) @map("captured_after_cutoff")
  planTitleSnapshot        String          @map("plan_title_snapshot")
  planVariantTitleSnapshot String          @map("plan_variant_title_snapshot")
  priceSnapshot            Decimal         @map("price_snapshot") @db.Decimal(10, 2)
  notes                    String?
  createdAt                DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  customer                 Customer        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  planVariant              PlanVariant?    @relation(fields: [planVariantId], references: [id], onDelete: SetNull)
  sourceWeeklyMenu         WeeklyMenu?     @relation(fields: [sourceWeeklyMenuId], references: [id], onDelete: SetNull)
  cycle                    WeeklyCycle     @relation(fields: [cycleId], references: [id], onDelete: Restrict)
  deliveries               OrderDelivery[]
  menuSlots                OrderMenuSlot[]
  statusEvents             OrderStatusEvent[]

  @@index([customerId, createdAt(sort: Desc)], map: "orders_customer_created_idx")
  @@index([status, createdAt(sort: Desc)], map: "orders_status_created_idx")
  @@index([planVariantId], map: "orders_plan_variant_idx")
  @@index([sourceWeeklyMenuId], map: "orders_source_menu_idx")
  @@index([cycleId, status], map: "orders_cycle_status_idx")
  @@map("orders")
}

model OrderDelivery {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId         String          @map("order_id") @db.Uuid
  sequence        Int
  scheduledDate   DateTime        @map("scheduled_date") @db.Date
  locationNumber  Int             @map("location_number")
  // Frozen when the delivery is created; later edits to the customer do not move it.
  addressSnapshot String          @map("address_snapshot")
  status          DeliveryStatus  @default(PENDING)
  deliveredAt     DateTime?       @map("delivered_at") @db.Timestamptz(3)
  notes           String?
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  order           Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuSlots       OrderMenuSlot[]

  @@unique([orderId, sequence], map: "order_deliveries_order_sequence_key")
  @@index([scheduledDate, status], map: "order_deliveries_date_status_idx")
  @@map("order_deliveries")
}

model OrderStatusEvent {
  id                 String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId            String          @map("order_id") @db.Uuid
  version            Int
  fromStatus         OrderStatus?    @map("from_status")
  toStatus           OrderStatus     @map("to_status")
  deliverySequence   Int?            @map("delivery_sequence")
  fromDeliveryStatus DeliveryStatus? @map("from_delivery_status")
  toDeliveryStatus   DeliveryStatus? @map("to_delivery_status")
  actorId            String?         @map("actor_id") @db.Uuid
  actorLabel         String?         @map("actor_label")
  reason             String?
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  order              Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, version], map: "order_status_events_order_version_idx")
  @@map("order_status_events")
}

model OrderMenuSlot {
  id         String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId    String               @map("order_id") @db.Uuid
  deliveryId String               @map("delivery_id") @db.Uuid
  dayOfWeek  DayOfWeek            @map("day_of_week")
  dayOrder   Int                  @map("day_order")
  slotType   SlotType             @map("slot_type")
  contenedor String?
  order      Order                @relation(fields: [orderId], references: [id], onDelete: Cascade)
  // NoAction (checked at end of statement) lets an order delete cascade to both
  // tables, while a delivery that still has meals cannot be removed on its own.
  delivery   OrderDelivery        @relation(fields: [deliveryId], references: [id], onDelete: NoAction)
  components OrderMenuComponent[]

  @@unique([orderId, dayOfWeek, slotType], map: "order_menu_slots_order_day_slot_key")
  @@index([deliveryId], map: "order_menu_slots_delivery_idx")
  @@index([orderId, dayOrder, slotType], map: "order_menu_slots_order_sequence_idx")
  @@map("order_menu_slots")
}

model OrderMenuComponent {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderMenuSlotId String           @map("order_menu_slot_id") @db.Uuid
  catalogItemId   String?          @map("catalog_item_id")
  componentRole   ComponentRole    @map("component_role")
  position        Int              @default(0)
  nombre          String
  descripcion     String
  calorias        Int
  imagen          String
  tipo            String
  // Where the dish sits in the week's menu; null for dishes added by hand.
  sourceDayOfWeek DayOfWeek?       @map("source_day_of_week")
  sourceSlotType  SlotType?        @map("source_slot_type")
  isSubstitution  Boolean          @default(false) @map("is_substitution")
  orderMenuSlot   OrderMenuSlot    @relation(fields: [orderMenuSlotId], references: [id], onDelete: Cascade)
  catalogItem     FoodCatalogItem? @relation(fields: [catalogItemId], references: [id], onDelete: SetNull)

  @@unique([orderMenuSlotId, componentRole, position], map: "order_menu_components_slot_role_position_key")
  @@index([catalogItemId], map: "order_menu_components_catalog_item_idx")
  @@map("order_menu_components")
}

model Expense {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  description       String
  amount            Decimal  @db.Decimal(12, 2)
  category          String
  paymentMethod     String   @map("payment_method")
  expenseDate       DateTime @map("expense_date") @db.Date
  vendor            String?
  billingReference1 String?  @map("billing_reference_1")
  billingReference2 String?  @map("billing_reference_2")
  expenseType       String   @default("variable") @map("expense_type")
  isInvoiced        Boolean  @default(false) @map("is_invoiced")
  notes             String?
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([expenseDate(sort: Desc), id], map: "expenses_date_id_idx")
  @@index([category, expenseDate(sort: Desc)], map: "expenses_category_date_idx")
  @@index([expenseType, expenseDate(sort: Desc)], map: "expenses_type_date_idx")
  @@index([isInvoiced, expenseDate(sort: Desc)], map: "expenses_invoiced_date_idx")
  @@map("expenses")
}

model OperationSettings {
  id                        Int         @id @default(1)
  cutoffDay                 DayOfWeek   @default(VIERNES) @map("cutoff_day")
  cutoffTime                String      @default("18:00") @map("cutoff_time")
  firstDeliveryAllowedDays  DayOfWeek[] @default([DOMINGO, LUNES]) @map("first_delivery_allowed_days")
  secondDeliveryAllowedDays DayOfWeek[] @default([MIERCOLES, JUEVES]) @map("second_delivery_allowed_days")
  firstDeliveryMealDays     DayOfWeek[] @default([LUNES, MARTES, MIERCOLES]) @map("first_delivery_meal_days")
  secondDeliveryMealDays    DayOfWeek[] @default([JUEVES, VIERNES]) @map("second_delivery_meal_days")
  timeZone                  String      @default("America/Tijuana") @map("time_zone")
  updatedAt                 DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("operation_settings")
}

model WeeklyCycle {
  id                        String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  weekStart                 DateTime    @unique(map: "weekly_cycles_week_start_key") @map("week_start") @db.Date
  status                    CycleStatus @default(DRAFT)
  orderCutoffAt             DateTime    @map("order_cutoff_at") @db.Timestamptz(3)
  firstDeliveryAllowedDays  DayOfWeek[] @map("first_delivery_allowed_days")
  secondDeliveryAllowedDays DayOfWeek[] @map("second_delivery_allowed_days")
  firstDeliveryMealDays     DayOfWeek[] @map("first_delivery_meal_days")
  secondDeliveryMealDays    DayOfWeek[] @map("second_delivery_meal_days")
  createdAt                 DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                 DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  menus                     WeeklyMenu[]
  orders                    Order[]

  @@index([status, weekStart(sort: Desc)], map: "weekly_cycles_status_week_idx")
  @@map("weekly_cycles")
}

enum CycleStatus {
  DRAFT
  OPEN
  CLOSED
  IN_PRODUCTION
  COMPLETED
}

enum DayOfWeek {
  LUNES
  MARTES
  MIERCOLES
  JUEVES
  VIERNES
  SABADO
  DOMINGO
}

enum SlotType {
  DESAYUNO
  COMIDA
  CENA
  SNACK1
  SNACK2
}

enum ComponentRole {
  PLATILLO_PRINCIPAL
  GUARNICION_1
  GUARNICION_2
  ADICIONAL
}

enum DeliveryStatus {
  PENDING
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED
}

enum OrderStatus {
  DRAFT
  CONFIRMED
  PREPARING
  PARTIALLY_DELIVERED
  DELIVERED
  CANCELLED
}
